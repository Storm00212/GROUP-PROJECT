{
  // ✅ Full TypeScript configuration for Node + Express + SQL Server (ESM)
  "compilerOptions": {
    /* === File Layout === */
    "rootDir": "./src",
    "outDir": "./dist",

    /* === ECMAScript / Module Settings === */
    "target": "ES2022",               // Modern JS features
    "module": "ESNext",               // Enables import/export syntax
    "moduleResolution": "Node",       // Simplifies import resolution for tsx
    "esModuleInterop": true,          // Allows default imports from CommonJS modules
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,        // In case you import config JSONs
    "isolatedModules": true,          // Required by tsx for on-the-fly compilation
    "verbatimModuleSyntax": false,    // ✅ Lets TS auto-strip type-only imports
    "forceConsistentCasingInFileNames": true,

    /* === Type Checking Options === */
    "strict": true,                   // Enables all strict type checking
    "skipLibCheck": true,             // Faster build; skip .d.ts verification
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* === Declarations / Source Maps === */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* === Node Environment === */
    "types": ["node"],                // Includes Node.js types
    "lib": ["ESNext"],                // Modern library support
  },

  /* === Files to Include / Exclude === */
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
